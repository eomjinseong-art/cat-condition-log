# Postgres (Neon / Vercel Marketplace Postgres 모두 DATABASE_URL 한 줄이면 됩니다)
# 예: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — 프로덕션에서는 반드시 임의의 32자 이상 비밀값을 넣으세요.
# openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# 선택: Vercel Blob. 없으면 사진은 업로드되지 않고, URL을 직접 넣을 수 있습니다.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
