generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  name                 String?
  passwordHash         String?
  disclaimerAcceptedAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  cats                 Cat[]
  logs                 Log[]
  reminders            Reminder[]
  media                Media[]
  medicationPlans      MedicationPlan[]
  medicationDoses      MedicationDose[]
  visits               Visit[]
  labEntries           LabEntry[]
  fluidLogs            FluidLog[]

  @@map("users")
}

model Cat {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  birthDate         DateTime?         @db.Date
  estimatedAgeYears Int?
  weightKg          Decimal?          @db.Decimal(6, 2)
  photoUrl          String?
  notes             String?
  seniorCare        Boolean           @default(false)
  conditions        String[]          @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  logs            Log[]
  reminders       Reminder[]
  media           Media[]
  medicationPlans MedicationPlan[]
  medicationDoses MedicationDose[]
  visits          Visit[]
  labEntries      LabEntry[]
  fluidLogs       FluidLog[]

  @@index([userId])
  @@map("cats")
}

model Log {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  catId         String
  cat           Cat           @relation(fields: [catId], references: [id], onDelete: Cascade)
  loggedOn      DateTime      @db.Date
  appetite      Appetite?
  foodNote      String?
  water         WaterIntake?
  stoolCount    Int?
  stoolQuality  StoolQuality?
  urine         Urine?
  vomit         Boolean?
  vomitNote     String?
  vomitPhotoUrl String?
  energy        Energy?
  weightKg      Decimal?      @db.Decimal(6, 2)
  memo          String?
  photoUrl      String?
  waterChange   ChangeLevel?
  urineChange   ChangeLevel?
  mobility      Mobility?
  nightVocal    NightVocal?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  media         Media[]

  @@unique([catId, loggedOn])
  @@index([userId, loggedOn])
  @@index([userId, catId])
  @@map("logs")
}

model Reminder {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  catId       String?
  cat         Cat?         @relation(fields: [catId], references: [id], onDelete: Cascade)
  type        ReminderType
  title       String
  dueOn       DateTime     @db.Date
  notes       String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, dueOn])
  @@map("reminders")
}

model MedicationPlan {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  catId        String
  cat          Cat              @relation(fields: [catId], references: [id], onDelete: Cascade)
  name         String
  doseNotes    String?
  frequency    MedFrequency
  timesPerDay  Int?
  weekdays     String?
  intervalDays Int?
  startOn      DateTime?        @db.Date
  endOn        DateTime?        @db.Date
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  doses        MedicationDose[]

  @@index([userId, catId])
  @@map("medication_plans")
}

model MedicationDose {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      MedicationPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  catId     String
  cat       Cat             @relation(fields: [catId], references: [id], onDelete: Cascade)
  takenOn   DateTime        @db.Date
  slot      Int             @default(0)
  givenAt   DateTime
  createdAt DateTime        @default(now())

  @@unique([planId, takenOn, slot])
  @@index([userId, takenOn])
  @@map("medication_doses")
}

model Visit {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  catId       String
  cat         Cat       @relation(fields: [catId], references: [id], onDelete: Cascade)
  visitOn     DateTime  @db.Date
  clinicName  String?
  reason      String?
  reminderOn  DateTime? @db.Date
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, visitOn])
  @@map("visits")
}

model LabEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  catId         String
  cat           Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  takenOn       DateTime @db.Date
  creatinine    Decimal? @db.Decimal(8, 3)
  sdma          Decimal? @db.Decimal(8, 2)
  bun           Decimal? @db.Decimal(8, 2)
  phosphorus    Decimal? @db.Decimal(8, 2)
  t4            Decimal? @db.Decimal(8, 2)
  bloodPressure Int?
  weightKg      Decimal? @db.Decimal(6, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, catId, takenOn])
  @@map("lab_entries")
}

model FluidLog {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  catId     String
  cat       Cat        @relation(fields: [catId], references: [id], onDelete: Cascade)
  givenOn   DateTime   @db.Date
  volumeMl  Int
  site      FluidSite?
  notes     String?
  createdAt DateTime   @default(now())

  @@index([userId, catId, givenOn])
  @@map("fluid_logs")
}

model Media {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  catId     String?
  cat       Cat?     @relation(fields: [catId], references: [id], onDelete: SetNull)
  logId     String?
  log       Log?     @relation(fields: [logId], references: [id], onDelete: SetNull)
  url       String
  kind      String   @default("photo")
  filename  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("media")
}

enum Appetite {
  NONE
  LOW
  NORMAL
  HIGH
}

enum WaterIntake {
  LITTLE
  NORMAL
  MUCH
}

enum StoolQuality {
  NONE
  HARD
  NORMAL
  SOFT
  DIARRHEA
}

enum Urine {
  LITTLE
  NORMAL
  MUCH
  BLOOD
}

enum Energy {
  LOW
  NORMAL
  HIGH
}

enum ReminderType {
  MEDS
  VACCINE
  DEWORMING
  LITTER_CHANGE
}

enum ChangeLevel {
  LESS
  SAME
  MORE
}

enum Mobility {
  GOOD
  STIFF
  PAIN
  HARD
}

enum NightVocal {
  NONE
  SOME
  MUCH
}

enum MedFrequency {
  DAILY
  TIMES_PER_DAY
  WEEKDAYS
  EVERY_N_DAYS
}

enum FluidSite {
  LEFT_SCRUFF
  RIGHT_SCRUFF
  OTHER
}
